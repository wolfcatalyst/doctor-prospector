# ============================================================
# Doctor Prospector - standalone settings
# ============================================================
# The installer copies this file to .env (same folder) and fills in
# SECRET_KEY. Edit .env, not this file. Restart the app after changes.
#
# Using Docker instead? Docker has its own settings in docker/.env
# (copy docker/.env.example). It runs PostgreSQL + Redis + nginx and
# ignores this file.
#
# What the app does (data sources, scoring, manual hospitals, cache) is
# configured in config.yaml. This file is only about how it runs.

# --- Database ---------------------------------------------------------
# Default: a single SQLite file, nothing else to install. Plenty for one
# person or a small team on the same computer. Back it up by copying it.
DATABASE_URL=sqlite+aiosqlite:///data/doctor_prospector.db
#
# Prefer PostgreSQL (shared server, many users)? Install PostgreSQL,
# create a database and user, then use:
#   DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@localhost:5432/doctor_prospector
# Then run the app once to create the tables, and reload the physician
# history: python scripts/refresh_all.py --only db_history --reimport-history
#
# Never put the SQLite file on a network/shared drive: SQLite can corrupt
# when several computers write to it. Use PostgreSQL for sharing instead.

# --- Redis (optional) -------------------------------------------------
# Only used to remember logged-out tokens when login is turned on
# (AUTH_ENABLED=true). Empty = keep that list in memory, which is fine for
# a single app process; it's just forgotten on restart.
REDIS_URL=
# To use a Redis server:
#   REDIS_URL=redis://localhost:6379/0

# --- Login ------------------------------------------------------------
# false = no login screen (single user on their own computer)
# true  = users must register/log in
# Off is fine when HOST is 127.0.0.1 (only this computer can connect).
# Turn it on if you set HOST=0.0.0.0 to share the app on your network.
# While it's off the app shows a "Login is off" notice; hide it in
# Settings > Preferences once you've decided.
AUTH_ENABLED=false
# Signs login tokens. The installer generates a random one. Keep it secret;
# changing it logs everyone out.
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Web server -------------------------------------------------------
# The app and its web pages are served together on one port:
#   http://localhost:8000
HOST=127.0.0.1
PORT=8000
# Serve the built web pages (frontend/dist) from the app itself.
# Only turn off if you serve frontend/dist with your own web server.
SERVE_FRONTEND=true

# Only needed if you run the frontend dev server (npm run dev) separately
CORS_ORIGINS=http://localhost:5173

# --- Misc -------------------------------------------------------------
DEBUG=false

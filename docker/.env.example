# ============================================
# Doctor Prospector - Environment Configuration
# ============================================
# Copy this file to docker/.env and fill in values

# --- App ---
APP_NAME=Doctor Prospector
APP_VERSION=1.0.0
DEBUG=false

# --- Database (PostgreSQL) ---
POSTGRES_USER=prospector
POSTGRES_PASSWORD=changeme_in_production
DATABASE_URL=postgresql+asyncpg://prospector:changeme_in_production@postgres:5432/doctor_prospector

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Auth ---
# Set to "true" to require login, "false" for dev mode (no auth needed)
AUTH_ENABLED=false
SECRET_KEY=generate-a-real-secret-key-here
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# Auth provider: "local" (JWT+bcrypt) or "oidc" (Authentik)
AUTH_PROVIDER=local

# --- OIDC / Authentik (Phase 7 - leave empty for now) ---
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_JWKS_URL=

# --- Ports ---
API_PORT=8400
FRONTEND_PORT=3100
POSTGRES_PORT=5432
REDIS_PORT=6379
STREAMLIT_PORT=8501

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3100

# --- Data Paths (inside container) ---
DATA_DIR=/app/data
CONFIG_YAML_PATH=/app/config.yaml
